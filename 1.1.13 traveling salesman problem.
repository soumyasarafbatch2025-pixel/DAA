#include <stdio.h>
#include <limits.h>

#define MAX_CITIES 15

int n;
int matrix[MAX_CITIES][MAX_CITIES];
int visited[MAX_CITIES];
int min_cost = INT_MAX;

// Recursive function to find the minimum TSP cost
void tsp(int current_city, int count, int current_cost) {
    // Base Case: If all cities have been visited
    if (count == n) {
        // Check if there is a path back to the starting city (0)
        if (matrix[current_city][0] != -1) {
            int total_cost = current_cost + matrix[current_city][0];
            if (total_cost < min_cost) {
                min_cost = total_cost;
            }
        }
        return;
    }

    // Optimization: Prune paths that are already more expensive than our best find
    if (current_cost >= min_cost) {
        return;
    }

    // Try moving to every other unvisited city
    for (int next_city = 0; next_city < n; next_city++) {
        if (!visited[next_city] && matrix[current_city][next_city] != -1) {
            // Mark city as visited
            visited[next_city] = 1;
            
            // Recurse to the next city
            tsp(next_city, count + 1, current_cost + matrix[current_city][next_city]);
            
            // Backtrack: Unmark city for other path combinations
            visited[next_city] = 0;
        }
    }
}

int main() {
    // Read the number of cities
    if (scanf("%d", &n) != 1) return 0;

    // Read the cost matrix
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Edge case: Only one city means no travel required
    if (n == 1) {
        printf("0\n");
        return 0;
    }

    // Initialize visited array (start city 0 is visited)
    for (int i = 0; i < n; i++) {
        visited[i] = 0;
    }
    visited[0] = 1;

    // Start the TSP traversal from city 0, count initialized to 1
    tsp(0, 1, 0);

    // Print the optimal cost found
    printf("%d\n", min_cost);

    return 0;
}

